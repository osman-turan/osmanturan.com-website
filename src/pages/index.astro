---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Avatar from "@/components/Avatar.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import s from "./index.module.css";

const CODING_START_YEAR = 1996;
const codingYears = new Date().getUTCFullYear() - CODING_START_YEAR;
---

<BaseLayout title="Osman Turan">
  <div class={s.header}></div>

  <div class={s.profile}>
    <Avatar />
    <div class={s.bio}>
      <h1>Osman Turan</h1>
      <p>Software Developer, Electrical-Electronics Engineer</p>
    </div>
  </div>

  <section class={s.section}>
    <h2>About</h2>
    <p>
      Coding over {codingYears} years since age 11. Full stack developer with engineering
      background with thorough hands-on experience from low-level kernel programming
      to single-page web applications, socket-level networking to computer generated
      graphics, desktop applications to distributed systems with help of Agile methodologies
      and full lifecycle management. Enjoys automating some mundane tasks - including
      playing video games! Loves to optimize his algorithms with Genetic Algorithms.
      Reverse-engineering is his last trump card for undocumented behaviors and APIs.
    </p>
  </section>

  <section class={s.section}>
    <h2>Contact</h2>
    <SocialLinks />
  </section>
</BaseLayout>
